# Saheli — Environment Configuration
# Copy to .env and adjust as needed.

# Path to the quantized GGUF model (downloaded by models/download_model.sh)
MODEL_PATH=./models/gemma-4-E4B-IT-Q4_K_M.gguf

# Whisper model size: tiny | base | small (recommended) | medium
WHISPER_MODEL=small

# Default language for the ASHA worker UI
# Options: ta (Tamil) | kn (Kannada) | hi (Hindi) | te (Telugu) | en (English)
DEFAULT_LANGUAGE=ta

# FastAPI server port
PORT=5000
